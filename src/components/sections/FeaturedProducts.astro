---
/**
 * FeaturedProducts — Home featured products grid (organism), task 5.3.
 *
 * Calls getFeaturedProducts() from the data layer and renders a
 * responsive grid of ProductCards with lazy loading (priority=false —
 * the hero sits above the fold, this section below it).
 *
 * Renders nothing when no product is featured (REQ-HP-002 / SCN-HP-002).
 * No props. <h2> section title (REQ-HP-003). Zero framework JS.
 */
import { getFeaturedProducts } from '@/data/helpers/products';
import ProductGrid from '../cards/ProductGrid.astro';

const featured = getFeaturedProducts();
---

{
  featured.length > 0 && (
    <section class="section section-deferred bg-light" aria-labelledby="featured-title">
      <div class="container">
        <div class="mb-8 md:mb-10">
          <h2 id="featured-title" class="section-title">
            Destacados
          </h2>
        </div>

        <ProductGrid products={featured} />
      </div>
    </section>
  )
}
