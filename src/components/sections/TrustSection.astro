---
/**
 * TrustSection — Home trust/assurance band (organism), task 5.5.
 *
 * Renders 6 trust indicators (free shipping, 2-year warranty, tech
 * support, secure payment, 30-day returns, free advice — REQ-HP-008) as
 * icon + text pairs, plus a generic inline WhatsApp CTA (no productName).
 *
 * The global FloatingWhatsApp instance is owned by HeroSection (tasks 5.1
 * dual-CTA + tasks 5.5 "once globally, not per-section") — it must NOT be
 * duplicated here. This section provides only the generic inline CTA.
 *
 * No props. Data (indicator list) lives in frontmatter so it can move to
 * a data layer later. Zero framework JS.
 */
import CTAWhatsApp from "../ui/CTAWhatsApp.astro";

// 24x24 Material-style icon paths (fill="currentColor"), keyed by name.
const icons = {
  truck:
    "M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z",
  shield:
    "M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z",
  support:
    "M21 12.22C21 6.73 16.74 3 12 3c-4.69 0-9 3.65-9 9.28-.6.34-1 .98-1 1.72v2c0 1.1.9 2 2 2h1v-6.1c0-3.87 3.13-7 7-7s7 3.13 7 7V19h-8v2h8c1.1 0 2-.9 2-2v-1.22c.59-.31 1-.92 1-1.64v-2.3c0-.7-.41-1.31-1-1.52z",
  lock: "M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z",
  returns:
    "M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm4 12h-4v3l-5-5 5-5v3h4v4z",
  advice:
    "M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zM9 19c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1z",
} as const;

const trustItems: { label: string; description: string; icon: keyof typeof icons }[] = [
  { label: "Envío gratis", description: "A todo el país", icon: "truck" },
  { label: "Garantía 2 años", description: "En todos nuestros productos", icon: "shield" },
  { label: "Soporte técnico", description: "Expertos a tu disposición", icon: "support" },
  { label: "Pago seguro", description: "Transferencia y efectivo", icon: "lock" },
  { label: "Devoluciones 30 días", description: "Cambios sin complicaciones", icon: "returns" },
  { label: "Asesoría gratis", description: "Te ayudamos a elegir", icon: "advice" },
];
---

<section class="section bg-light" aria-labelledby="trust-title">
  <div class="container">
    <div class="mb-8 text-center md:mb-10">
      <h2 id="trust-title">Compra con confianza</h2>
    </div>

    <ul class="mx-auto grid max-w-4xl grid-cols-2 gap-6 md:grid-cols-3">
      {trustItems.map((item) => (
        <li class="flex flex-col items-center gap-2 text-center">
          <span
            class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary"
            aria-hidden="true"
          >
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
              <path d={icons[item.icon]} />
            </svg>
          </span>
          <span class="text-sm font-semibold text-text-dark">{item.label}</span>
          <span class="text-xs text-text-light">{item.description}</span>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex justify-center">
      <CTAWhatsApp variant="inline" class="btn-lg" />
    </div>
  </div>
</section>