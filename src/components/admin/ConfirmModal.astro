---
/**
 * ConfirmModal component — server-rendered confirmation dialog for archive action
 * Uses native <dialog> element, no JavaScript required
 * Accessible: role="dialog", aria-labelledby, aria-describedby, focus trap on open
 */

interface Props {
  id: string;
  title?: string;
  message?: string;
  confirmText?: string;
  cancelText?: string;
  cancelHref?: string;
  action?: string;
  method?: 'POST' | 'DELETE';
  open?: boolean;
}

const {
  id,
  title = 'Archivar producto',
  message = '¿Archivar este producto? Se ocultará de la tienda pero se puede restaurar más tarde.',
  confirmText = 'Archivar',
  cancelText = 'Cancelar',
  cancelHref,
  action,
  method = 'POST',
  open = false,
} = Astro.props;

const dialogId = `confirm-modal-${id}`;
const titleId = `${dialogId}-title`;
const messageId = `${dialogId}-message`;
---

<dialog id={dialogId} class="admin-confirm-modal" open={open} role="dialog" aria-labelledby={titleId} aria-describedby={messageId} aria-modal="true">
  <form method={method} action={action} class="admin-confirm-modal-content">
    <h2 id={titleId} class="admin-confirm-modal-title">{title}</h2>
    <p id={messageId} class="admin-confirm-modal-message">{message}</p>

    <div class="admin-confirm-modal-actions">
      {cancelHref && (
        <a href={cancelHref} class="btn btn-outline-primary min-h-[44px] touch-target">{cancelText}</a>
      )}
      <button
        type="submit"
        class="btn btn-primary min-h-[44px] touch-target bg-red-600 border-red-700 hover:bg-red-700"
        aria-label={confirmText}
      >
        {confirmText}
      </button>
    </div>
  </form>

  <!-- Backdrop click to close (form submission not triggered) -->
  <script is:inline>
    (function() {
      const dialog = document.getElementById('${dialogId}');
      if (!dialog) return;

      // Close on Escape key
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          dialog.close();
        }
      });

      // Close on backdrop click (outside form)
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          e.clientX >= rect.left &&
          e.clientX <= rect.right &&
          e.clientY >= rect.top &&
          e.clientY <= rect.bottom
        );
        if (!isInDialog) {
          dialog.close();
        }
      });

      // Focus trap
      dialog.addEventListener('focusin', (e) => {
        const focusableElements = dialog.querySelectorAll(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.target === lastElement && !e.shiftKey) {
          e.preventDefault();
          firstElement?.focus();
        } else if (e.target === firstElement && e.shiftKey) {
          e.preventDefault();
          lastElement?.focus();
        }
      });

      // Auto-focus first focusable element on open
      if (dialog.open) {
        const firstFocusable = dialog.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        firstFocusable?.focus();
      }
    })();
  </script>
</dialog>

<style>
  @reference "../../styles/main.css";

  .admin-confirm-modal {
    @apply fixed inset-0 z-50 flex items-center justify-center p-4;
    border: none;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .admin-confirm-modal::backdrop {
    @apply bg-black/50 backdrop-blur-sm;
  }

  .admin-confirm-modal[open] {
    display: flex;
  }

  .admin-confirm-modal-content {
    @apply bg-body dark:bg-body-dark rounded-xl shadow-xl max-w-md w-full p-6 border border-border dark:border-border-dark;
    animation: modal-slide-in 0.2s ease-out;
  }

  @keyframes modal-slide-in {
    from {
      opacity: 0;
      transform: translateY(-20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .admin-confirm-modal-title {
    @apply text-lg font-semibold text-text-dark dark:text-text-dark mb-3;
  }

  .admin-confirm-modal-message {
    @apply text-text dark:text-text mb-6;
  }

  .admin-confirm-modal-actions {
    @apply flex flex-col sm:flex-row gap-3 justify-end;
  }

  .admin-confirm-modal-actions .btn {
    @apply flex-1 sm:flex-none min-w-[120px];
  }

  /* Focus styles for accessibility */
  .admin-confirm-modal-content:focus-within {
    @apply ring-2 ring-primary ring-offset-2 dark:ring-offset-body-dark;
  }
</style>