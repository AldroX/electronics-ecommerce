---
import type { ProductAdminListResponse } from '@/data/types';

/**
 * ProductTable component — renders admin product list table with pagination, sorting, and filters
 * Zero client JS — all interactions via standard HTML forms
 */

interface Props {
  data: ProductAdminListResponse;
  categories: { id: string; name: string }[];
  filters: {
    search?: string;
    category?: string;
    availability?: string;
    sort?: string;
    showArchived?: boolean;
  };
  currentPath: string;
}

const { data, categories, filters, currentPath } = Astro.props;

const { products, pagination } = data;
const { page, limit, total, totalPages } = pagination;
const { search = '', category = '', availability = '', sort = 'created-desc', showArchived = false } = filters;

const sortOptions = [
  { value: 'name-asc', label: 'Nombre (A-Z)' },
  { value: 'name-desc', label: 'Nombre (Z-A)' },
  { value: 'price-asc', label: 'Precio (menor a mayor)' },
  { value: 'price-desc', label: 'Precio (mayor a menor)' },
  { value: 'created-desc', label: 'Más recientes' },
  { value: 'updated-desc', label: 'Actualizados recientemente' },
];

const availabilityOptions = [
  { value: '', label: 'Todas' },
  { value: 'in-stock', label: 'En stock' },
  { value: 'limited', label: 'Stock limitado' },
  { value: 'out-of-stock', label: 'Agotado' },
];

function getAvailabilityBadgeClass(availability: string): string {
  switch (availability) {
    case 'in-stock':
      return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400';
    case 'limited':
      return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400';
    case 'out-of-stock':
      return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400';
    default:
      return 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400';
  }
}

function getAvailabilityLabel(availability: string): string {
  switch (availability) {
    case 'in-stock':
      return 'En stock';
    case 'limited':
      return 'Stock limitado';
    case 'out-of-stock':
      return 'Agotado';
    default:
      return availability;
  }
}

function formatPrice(price: number, currency: string): string {
  return new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(price);
}

function buildPageUrl(pageNum: number): string {
  const params = new URLSearchParams();
  if (pageNum > 1) params.set('page', String(pageNum));
  if (search) params.set('search', search);
  if (category) params.set('category', category);
  if (availability) params.set('availability', availability);
  if (sort !== 'created-desc') params.set('sort', sort);
  if (showArchived) params.set('showArchived', 'true');
  return `${currentPath}?${params.toString()}`;
}

function buildSortUrl(newSort: string): string {
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (category) params.set('category', category);
  if (availability) params.set('availability', availability);
  if (newSort !== 'created-desc') params.set('sort', newSort);
  if (showArchived) params.set('showArchived', 'true');
  return `${currentPath}?${params.toString()}`;
}

function getPageNumbers(): number[] {
  if (totalPages <= 5) {
    return Array.from({ length: totalPages }, (_, i) => i + 1);
  }
  if (page <= 3) {
    return [1, 2, 3, 4, 5];
  }
  if (page >= totalPages - 2) {
    return [totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
  }
  return [page - 2, page - 1, page, page + 1, page + 2];
}

const pageNumbers = getPageNumbers();
---

<!-- Filter Form -->
<form
  method="GET"
  action={currentPath}
  class="admin-filter-form mb-6 p-4 bg-body border border-border rounded-lg"
  role="search"
  aria-label="Filtros de productos"
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
    <div class="lg:col-span-2">
      <label for="search" class="form-label">Buscar</label>
      <input
        type="search"
        id="search"
        name="search"
        value={search}
        placeholder="Nombre, slug..."
        class="form-input"
        aria-describedby="search-help"
      />
      <span id="search-help" class="sr-only">Buscar productos por nombre o slug</span>
    </div>

    <div>
      <label for="category" class="form-label">Categoría</label>
      <select id="category" name="category" class="form-input">
        <option value="">Todas las categorías</option>
        {
          categories.map((cat) => (
            <option value={cat.id} selected={category === cat.id}>
              {cat.name}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="availability" class="form-label">Disponibilidad</label>
      <select id="availability" name="availability" class="form-input">
        {
          availabilityOptions.map((opt) => (
            <option value={opt.value} selected={availability === opt.value}>
              {opt.label}
            </option>
          ))
        }
      </select>
    </div>

    <div class="flex gap-2">
      <button type="submit" class="btn btn-primary btn-sm flex-1 min-h-[44px] touch-target">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
          ></path>
        </svg>
        Filtrar
      </button>
      <a
        href={currentPath}
        class="btn btn-outline-primary btn-sm min-h-[44px] touch-target"
        aria-label="Limpiar filtros"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Hidden fields for sort and showArchived -->
  <input type="hidden" name="sort" value={sort} />
  <input type="hidden" name="showArchived" value={showArchived ? 'true' : 'false'} />
</form>

<!-- Table -->
<div class="admin-table-wrapper overflow-x-auto bg-body border border-border rounded-lg">
  {
    products.length > 0 ? (
      <table class="admin-table w-full" role="grid" aria-label="Lista de productos">
        <thead class="bg-body-muted/50 dark:bg-body-muted-dark/50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-sm font-medium text-text-light dark:text-text-light-dark">
              Imagen
            </th>
            <th scope="col" class="px-4 py-3 text-left text-sm font-medium text-text-light dark:text-text-light-dark">
              <a
                href={buildSortUrl(sort === 'name-asc' ? 'name-desc' : 'name-asc')}
                class="flex items-center gap-1 hover:text-primary transition-colors"
              >
                Nombre / Slug
                {sort === 'name-asc' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                )}
                {sort === 'name-desc' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
            </th>
            <th scope="col" class="px-4 py-3 text-left text-sm font-medium text-text-light dark:text-text-light-dark">
              Categoría
            </th>
            <th scope="col" class="px-4 py-3 text-left text-sm font-medium text-text-light dark:text-text-light-dark">
              <a
                href={buildSortUrl(sort === 'price-asc' ? 'price-desc' : 'price-asc')}
                class="flex items-center gap-1 hover:text-primary transition-colors"
              >
                Precio
                {sort === 'price-asc' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                )}
                {sort === 'price-desc' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
            </th>
            <th scope="col" class="px-4 py-3 text-left text-sm font-medium text-text-light dark:text-text-light-dark">
              <a
                href={buildSortUrl(sort === 'created-desc' ? 'updated-desc' : 'created-desc')}
                class="flex items-center gap-1 hover:text-primary transition-colors"
              >
                Disponibilidad
                {sort === 'created-desc' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                )}
                {sort === 'updated-desc' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
            </th>
            <th scope="col" class="px-4 py-3 text-left text-sm font-medium text-text-light dark:text-text-light-dark">
              Acciones
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border dark:divide-border-dark">
          {products.map((product) => (
            <tr class="hover:bg-body-muted/50 dark:hover:bg-body-muted-dark/50 transition-colors">
              <td class="px-4 py-3">
                {product.thumbnail ? (
                  <img
                    src={product.thumbnail}
                    alt=""
                    class="w-16 h-16 object-cover rounded-lg border border-border"
                    loading="lazy"
                    aria-hidden="true"
                  />
                ) : (
                  <div
                    class="w-16 h-16 rounded-lg bg-body-muted dark:bg-body-muted-dark flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <svg
                      class="w-8 h-8 text-text-light dark:text-text-light-dark"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  </div>
                )}
              </td>
              <td class="px-4 py-3">
                <div>
                  <p class="font-medium text-text-dark dark:text-text-dark truncate max-w-xs">{product.name}</p>
                  <p class="text-sm text-text-light dark:text-text-light-dark font-mono">/{product.slug}</p>
                </div>
              </td>
              <td class="px-4 py-3 text-text dark:text-text">{product.categoryName}</td>
              <td class="px-4 py-3 font-medium text-text-dark dark:text-text-dark">
                {formatPrice(product.price, product.currency)}
              </td>
              <td class="px-4 py-3">
                <span
                  class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getAvailabilityBadgeClass(product.availability)}`}
                >
                  {getAvailabilityLabel(product.availability)}
                </span>
                {product.featured && (
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                    Destacado
                  </span>
                )}
                {product.bestSeller && (
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-accent/10 text-accent dark:bg-accent/20 dark:text-accent">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                    Best Seller
                  </span>
                )}
                {product.deletedAt && (
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400">
                    Archivado
                  </span>
                )}
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <a
                    href={`/admin/products/${product.id}`}
                    class="btn btn-outline-primary btn-sm min-h-[44px] touch-target"
                    aria-label={`Editar ${product.name}`}
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                      />
                    </svg>
                    <span class="hidden sm:inline">Editar</span>
                  </a>
                  <form
                    method="POST"
                    action={`/admin/products/${product.id}/delete`}
                    class="inline"
                    onsubmit="return confirm('¿Archivar este producto? Se ocultará de la tienda pero se puede restaurar después.')"
                  >
                    <button
                      type="submit"
                      class="btn btn-outline-primary btn-sm min-h-[44px] touch-target text-red-600 border-red-300 hover:bg-red-50 dark:hover:bg-red-900/20"
                      aria-label={`Archivar ${product.name}`}
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                        />
                      </svg>
                      <span class="hidden sm:inline">Archivar</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <div class="p-12 text-center">
        <svg
          class="w-16 h-16 mx-auto text-text-light dark:text-text-light-dark mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
          />
        </svg>
        <h3 class="text-lg font-medium text-text-dark dark:text-text-dark mb-2">No se encontraron productos</h3>
        <p class="text-text-light dark:text-text-light-dark mb-6">
          Intenta ajustar los filtros o crea un nuevo producto.
        </p>
        <a href="/admin/products/new" class="btn btn-primary min-h-[44px] touch-target">
          Crear primer producto
        </a>
      </div>
    )
  }
</div>

<!-- Pagination -->
{
  totalPages > 1 && (
    <nav class="admin-pagination mt-6 flex items-center justify-between" aria-label="Paginación de productos">
      <div class="text-sm text-text-light dark:text-text-light-dark">
        Mostrando <span class="font-medium">{(page - 1) * limit + 1}</span> a{' '}
        <span class="font-medium">{Math.min(page * limit, total)}</span> de <span class="font-medium">{total}</span>{' '}
        productos
      </div>
      <div class="flex items-center gap-2">
        {page > 1 && (
          <a
            href={buildPageUrl(page - 1)}
            class="btn btn-outline-primary btn-sm min-h-[44px] touch-target"
            aria-label="Página anterior"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Anterior
          </a>
        )}

        <div class="flex items-center gap-1" role="navigation" aria-label="Números de página">
          {pageNumbers.map((pageNum) => (
            <a
              href={buildPageUrl(pageNum)}
              class={`px-3 py-1.5 rounded-lg text-sm font-medium min-w-[44px] min-h-[44px] flex items-center justify-center touch-target transition-colors ${
                pageNum === page
                  ? 'bg-primary text-white'
                  : 'text-text-light dark:text-text-light-dark hover:bg-body-muted dark:hover:bg-body-muted-dark'
              }`}
              aria-label={`Página ${pageNum}`}
              aria-current={pageNum === page ? 'page' : undefined}
            >
              {pageNum}
            </a>
          ))}
        </div>

        {page < totalPages && (
          <a
            href={buildPageUrl(page + 1)}
            class="btn btn-outline-primary btn-sm min-h-[44px] touch-target"
            aria-label="Página siguiente"
          >
            Siguiente
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  @reference "../../styles/main.css";

  .admin-table {
    border-collapse: collapse;
  }

  .admin-table th,
  .admin-table td {
    @apply px-4 py-3;
  }

  .admin-table th {
    @apply text-left text-sm font-medium text-text-light dark:text-text-light-dark;
  }

  .admin-table td {
    @apply text-sm text-text dark:text-text;
  }

  .admin-table tbody tr {
    @apply hover:bg-body-muted/50 dark:hover:bg-body-muted-dark/50 transition-colors;
  }

  .admin-filter-form {
    @apply bg-body border border-border rounded-lg;
  }

  .admin-pagination {
    @apply flex flex-col sm:flex-row items-center justify-between gap-4;
  }

  @media (max-width: 640px) {
    .admin-table th:nth-child(3),
    .admin-table td:nth-child(3),
    .admin-table th:nth-child(4),
    .admin-table td:nth-child(4) {
      display: none;
    }
  }
</style>
