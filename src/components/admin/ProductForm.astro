  }

  #related-search-results button {
    @apply w-full px-3 py-2 text-left hover:bg-body-muted dark:hover:bg-body-muted-dark transition-colors border-b border-border dark:border-border-dark last:border-0;
  }

  /* Checkbox styling */
  .form-checkbox {
    @apply appearance-none border border-border rounded bg-body checked:bg-primary checked:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50 focus:ring-offset-2 dark:focus:ring-offset-body-dark;
  }

  @media (max-width: 640px) {
