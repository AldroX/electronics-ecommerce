  }

  .admin-form-field {
    @apply space-y-1.5;
  }

  .form-error {
    @apply text-sm text-red-600 dark:text-red-400;
  }

  .form-help {
    @apply text-xs text-text-light dark:text-text-light-dark mt-1;
  }

  .admin-dynamic-row {
    @apply flex items-center gap-3;
  }

  .admin-form-actions {
    @apply flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-6 border-t border-border dark:border-border-dark;
  }

  .btn-loading {
