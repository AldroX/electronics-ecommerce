---
/**
 * Breadcrumbs — Breadcrumb navigation.
 *
 * Renders: Home > Category > Product (current, no link).
 * JSON-LD structured data is owned by Base.astro <head>.
 */
import type { Product, Category } from '@/data/types';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';

export interface Props {
  product: Product;
  categories: Category[];
}

const { product, categories } = Astro.props;

// Find the matching category by slug
const category = categories.find((c) => c.slug === product.category);

const items: Array<{ name: string; url?: string }> = [{ name: 'Inicio', url: '/' }];

if (category) {
  items.push({
    name: category.name,
    url: `/categoria/${category.slug}`,
  });
}

// Current product is the last item — no URL (aria-current="page")
items.push({ name: product.name });
---

<Breadcrumbs items={items} />
