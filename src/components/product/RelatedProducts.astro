---
/**
 * RelatedProducts — Grid of ProductCards related to the current product.
 *
 * Two sources, in priority order:
 *  1. Explicit curated `relatedSlugs` (slugs, in display order) when the
 *     list is non-empty — missing slugs are skipped gracefully.
 *  2. Fallback: products from the same category, excluding the current one.
 *
 * Renders nothing when fewer than 2 related products exist (avoids a
 * nearly-empty section). Zero framework JS.
 */
import type { Product } from '@/data/types';
import ProductGrid from '../cards/ProductGrid.astro';

export interface Props {
  product: Product;
  allProducts: Product[];
  /** Explicitly curated related product slugs in display order. */
  relatedSlugs?: string[];
}

const { product, allProducts, relatedSlugs = [] } = Astro.props;

const explicitRelated = relatedSlugs
  .map((slug) => allProducts.find((p) => p.slug === slug))
  .filter((p): p is Product => Boolean(p))
  .filter((p) => p.id !== product.id)
  .slice(0, 4);

const related =
  explicitRelated.length > 0
    ? explicitRelated
    : allProducts.filter((p) => p.category === product.category && p.id !== product.id).slice(0, 4);

// Avoid rendering a nearly-empty related section
const shouldRender = related.length >= 2;
---

{
  shouldRender && (
    <section>
      <h2 class="mb-6 text-h5 font-bold text-text-dark">Productos relacionados</h2>
      <ProductGrid products={related} />
    </section>
  )
}
