---
/**
 * OfferCard — Promotional offer display card (molecule).
 *
 * Displays:
 *  - discount badge (red, prominent)
 *  - availability badge (emerald/amber/red)
 *  - price with original strikethrough and current price in primary color
 *  - validUntil formatted as "Válido hasta DD/MM"
 *  - WhatsApp CTA (hidden when out-of-stock)
 *  - whole card links to /producto/{productSlug}
 *
 * Zero framework JS.
 */
import type { Offer } from '@/data/types';
import CTAWhatsApp from '../ui/CTAWhatsApp.astro';

export interface Props {
  offer: Offer;
  href?: string;
}

const { offer, href } = Astro.props;
const linkHref = href || `/producto/${offer.productSlug}`;

const isOutOfStock = offer.availability === 'out-of-stock';

// Price formatting
const formatter = new Intl.NumberFormat('es', {
  style: 'currency',
  currency: offer.currency,
});
const currentPriceFormatted = formatter.format(offer.currentPrice);
const originalPriceFormatted = formatter.format(offer.originalPrice);

// Availability badge mapping
const availabilityMap = {
  'in-stock': { label: 'Disponible', class: 'bg-emerald-100 text-emerald-700' },
  limited: { label: 'Pocas unidades', class: 'bg-amber-100 text-amber-700' },
  'out-of-stock': { label: 'Agotado', class: 'bg-red-100 text-red-700' },
} as const;
const stockKey = offer.availability as keyof typeof availabilityMap;
const badge = availabilityMap[stockKey] ?? availabilityMap['in-stock'];

// Format validUntil as "Válido hasta DD/MM"
const validUntilDate = new Date(offer.validUntil + 'T00:00:00');
const validUntilFormatted = new Intl.DateTimeFormat('es', {
  day: '2-digit',
  month: '2-digit',
}).format(validUntilDate);
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-white shadow transition hover:shadow-lg scroll-mt-24',
    isOutOfStock && 'opacity-60',
  ]}
>
  {/* Discount badge */}
  <div class="relative bg-red-500 px-3 py-1.5 text-center">
    <span class="text-sm font-bold text-white">-{offer.discountPercent}%</span>
  </div>

  {/* Image */}
  <div class="relative aspect-[4/3] w-full shrink-0 overflow-hidden bg-light">
    <img
      src={offer.image}
      alt={offer.name}
      loading="lazy"
      width="400"
      height="300"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105"
      onerror="this.src='/images/placeholder-product.svg'"
    />
  </div>

  <a href={linkHref} class="flex h-full flex-1 flex-col" aria-label={`Ver oferta: ${offer.name}`}>
    <div class="flex flex-1 flex-col gap-3 p-4">
      {/* Availability badge */}
      <span class={`inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${badge.class}`}>
        {badge.label}
      </span>

      <h3 class="text-h6 font-bold leading-snug text-text-dark">{offer.name}</h3>

      {offer.description && <p class="line-clamp-2 text-sm text-text-light">{offer.description}</p>}

      {/* Prices */}
      <div class="mt-auto flex items-baseline gap-2 pt-2">
        <span class="text-lg font-bold text-primary">{currentPriceFormatted}</span>
        <span class="text-sm text-text-light line-through">{originalPriceFormatted}</span>
      </div>

      {/* Valid until */}
      <p class="text-xs text-text-light">
        Válido hasta {validUntilFormatted}
      </p>
    </div>
  </a>

  {/* WhatsApp CTA - hidden when out-of-stock */}
  {
    !isOutOfStock && (
      <div class="shrink-0 px-4 pb-4">
        <CTAWhatsApp
          variant="inline"
          productName={offer.name}
          messageTemplate={offer.whatsappMessage.replace('{PRODUCTO}', offer.name)}
          class="w-full"
        />
      </div>
    )
  }
</article>
