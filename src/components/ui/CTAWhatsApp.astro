---
/**
 * CTAWhatsApp — Reusable WhatsApp call-to-action.
 *
 * Two variants:
 *  - inline:   text + icon button used inside cards/sections (REQ-CW-001, REQ-CW-003)
 *  - floating: fixed bottom-right circular icon button (REQ-CW-001, REQ-CW-004)
 *
 * Message resolution (REQ-CW-002, REQ-CW-007, SCN-CW-003):
 *   messageTemplate prop > whatsapp.json.message_template > whatsapp.json.default_message
 *   "{product}" is interpolated with productName, or with the generic subject
 *   "sus productos" when no productName is provided.
 *
 * Fallbacks (task 3.1):
 *   - missing template            -> whatsapp.json.default_message
 *   - missing/empty number        -> nothing is rendered
 *
 * Zero framework JS: static anchor, build-time message generation only.
 */
import whatsapp from "@/config/whatsapp.json";

export interface Props {
  variant: "inline" | "floating";
  /** Interpolated into the "{product}" placeholder of the message template. */
  productName?: string;
  /** Overrides the template from whatsapp.json. */
  messageTemplate?: string;
  /** Additional Tailwind classes merged onto the anchor. */
  class?: string;
}

const { variant = "inline", productName, messageTemplate, class: customClass } = Astro.props;

interface WhatsAppConfig {
  number?: string;
  message_template?: string;
  default_message?: string;
}

const config = whatsapp as WhatsAppConfig;

// URL-safe number check (REQ-CW-003): missing number renders nothing.
const number = typeof config.number === "string" && config.number.trim() !== "" ? config.number : null;

// Last-resort generic message when the config is missing or malformed (SCN-CW-003).
const FALLBACK_MESSAGE = "Hola, estoy interesado en sus productos. ¿Está disponible?";

// Template fallback chain (SCN-CW-003): prop > message_template > default_message > hardcoded.
const template = messageTemplate ?? config.message_template ?? config.default_message ?? FALLBACK_MESSAGE;

// {product} interpolation (REQ-CW-002): generic subject when no productName (REQ-CW-007).
const subject = productName ?? "sus productos";
const message = template.replaceAll("{product}", subject);

const href = number ? `https://wa.me/${number}?text=${encodeURIComponent(message)}` : null;

// Spanish accessible label (REQ-CW-003, REQ-CW-004).
const label = productName
  ? `Consultar disponibilidad de ${productName} por WhatsApp`
  : "Contactar por WhatsApp";

// Shared a11y + sizing (REQ-CW-005, REQ-CW-006): 2px outline, 2px offset, >= 44x44px.
const baseClasses =
  "min-h-[44px] min-w-[44px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark";
---

{href && variant === "inline" && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={label}
      class:list={["btn btn-whatsapp inline-flex items-center justify-center gap-2", baseClasses, customClass]}
    >
      <svg class="inline-block h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
      <span>WhatsApp</span>
    </a>
  )}
  {href && variant === "floating" && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={label}
      class:list={[
        "cta-whatsapp-floating fixed bottom-4 right-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg",
        "transition-transform duration-200 motion-safe:hover:scale-110",
        baseClasses,
        customClass,
      ]}
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
    </a>
  )}