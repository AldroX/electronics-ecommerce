---
/**
 * FAQ page — /faq
 *
 * Lists all FAQ items with accordion interface.
 *
 * Zero framework JS — vanilla JS toggle.
 */
import Base from '@/layouts/Base.astro';
import config from '@/config/config.json';
import { getAllFAQs } from '@/data/helpers/faq';
import FAQ from '@/components/sections/FAQ.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';

const faqs = getAllFAQs();
const siteTitle = config.site.title;
const baseUrl = config.site.base_url;

// Breadcrumb items — relative urls for the visible nav, absolute for JSON-LD
const breadcrumbItems: Array<{ name: string; url?: string }> = [{ name: 'Inicio', url: '/' }, { name: 'FAQ' }];

const breadcrumbJsonLdItems = breadcrumbItems.map((item) => (item.url ? { ...item, url: `${baseUrl}${item.url}` } : item));

// FAQPage JSON-LD (schema.org FAQPage)
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<Base
  meta_title={`Preguntas frecuentes | ${siteTitle}`}
  description="Respuestas a las dudas más comunes sobre compra, envío, garantía y qué equipo necesitás."
  canonical={`${baseUrl}/faq`}
  breadcrumbs={breadcrumbJsonLdItems}
>
  <!-- FAQPage JSON-LD structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} slot="head" />

  <section class="section">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />

      <h1 class="text-h2 mb-8">Preguntas frecuentes</h1>

      <FAQ />
    </div>
  </section>
</Base>
