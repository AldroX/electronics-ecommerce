---
/**
 * Paginated catalog pages — /productos/page/2, /productos/page/3, etc.
 *
 * Generates static pages for SEO crawlability. Same layout as /productos (page 1).
 * Client-side filter/sort via vanilla JS re-renders the grid on interaction.
 */
import type { GetStaticPaths } from "astro";
import type { Product } from "../../../data/types";
import Base from "../../../layouts/Base.astro";
import { getAllProducts } from "../../../data/helpers/products";
import ProductFilters from "../../../components/cards/ProductFilters.astro";
import CatalogGrid from "../../../components/cards/CatalogGrid.astro";

const PER_PAGE = 12;

export const getStaticPaths: GetStaticPaths = ({ paginate }) => {
  const products = getAllProducts();
  return paginate(products, { pageSize: PER_PAGE });
};

interface CatalogPage {
  data: Product[];
  currentPage: number;
  lastPage: number;
  total: number;
  start: number;
  end: number;
  size: number;
  url: {
    current: string;
    prev: string | undefined;
    next: string | undefined;
    first: string | undefined;
    last: string | undefined;
  };
}

const { page } = Astro.props as { page: CatalogPage };
const allProducts = getAllProducts();

const metaTitle = page.currentPage > 1
  ? `Catálogo de Productos — Página ${page.currentPage}`
  : "Catálogo de Productos";
const description =
  "Explora nuestro catálogo de paneles solares, power stations, baterías LiFePO4, iluminación LED y accesorios. Compra por WhatsApp.";
---

<Base
  meta_title={metaTitle}
  description={description}
  image="/images/placeholder-category.webp"
>
  <!-- Hero Section -->
  <section class="section bg-gradient" aria-labelledby="catalog-title">
    <div class="container">
      <div class="max-w-3xl">
        <h1 id="catalog-title" class="text-h1-sm md:text-h1">
          Catálogo de Productos
        </h1>
        <p class="mt-4 max-w-2xl text-base text-text-light md:text-lg">
          Encuentra la solución energética que necesitas. Filtra por categoría,
          precio y disponibilidad. Asesoría gratis por WhatsApp.
        </p>
      </div>
    </div>
  </section>

  <!-- Catalog Content -->
  <section class="section" aria-labelledby="catalog-results-title">
    <div class="container">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filters (Desktop) -->
        <aside class="lg:w-64 flex-shrink-0 hidden lg:block">
          <ProductFilters />
        </aside>

        <!-- Mobile Filter Toggle + Main Content -->
        <div class="flex-1 min-w-0">
          <!-- Mobile Filter Toggle -->
          <div class="lg:hidden mb-6">
            <button
              type="button"
              id="mobile-filter-toggle"
              aria-expanded="false"
              aria-controls="mobile-filters"
              class="btn btn-outline-primary w-full justify-center gap-2"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 3h18v18H3z" />
                <path d="M7 7h10" />
                <path d="M7 12h10" />
                <path d="M7 17h10" />
              </svg>
              Filtros
            </button>
            <div id="mobile-filters" class="mt-4 hidden" role="region" aria-label="Filtros móviles">
              <ProductFilters />
            </div>
          </div>

          <!-- Catalog Grid (shared component) -->
          <CatalogGrid page={page} />
        </div>
      </div>
    </div>
  </section>

  <!-- Embedded catalog data for client-side filtering -->
  <script type="application/json" id="catalog-data" is:inline set:html={JSON.stringify(allProducts)} />

  <!-- Client-side filter/sort interactivity -->
  <script is:inline>
    (function () {
      var catalogData = JSON.parse(document.getElementById("catalog-data").textContent);

      function filterProducts(products, filters) {
        var result = products.slice();
        if (filters.search) {
          var q = filters.search.toLowerCase();
          result = result.filter(function (p) {
            return p.name.toLowerCase().includes(q) ||
              p.description.toLowerCase().includes(q) ||
              p.shortDescription.toLowerCase().includes(q) ||
              p.tags.some(function (t) { return t.toLowerCase().includes(q); });
          });
        }
        if (filters.categories && filters.categories.length > 0) {
          result = result.filter(function (p) { return filters.categories.includes(p.category); });
        }
        if (typeof filters.priceMin === "number" && !isNaN(filters.priceMin)) {
          result = result.filter(function (p) { return p.price >= filters.priceMin; });
        }
        if (typeof filters.priceMax === "number" && !isNaN(filters.priceMax)) {
          result = result.filter(function (p) { return p.price <= filters.priceMax; });
        }
        if (filters.availability && filters.availability.length > 0) {
          result = result.filter(function (p) { return filters.availability.includes(p.availability); });
        }
        return result;
      }

      function sortProducts(products, sortBy) {
        var sorted = products.slice();
        switch (sortBy) {
          case "price-asc": sorted.sort(function (a, b) { return a.price - b.price; }); break;
          case "price-desc": sorted.sort(function (a, b) { return b.price - a.price; }); break;
          case "name-asc": sorted.sort(function (a, b) { return a.name.localeCompare(b.name, "es"); }); break;
          default: break;
        }
        return sorted;
      }

      var PLACEHOLDER = "/images/placeholder-product.svg";
      var availabilityLabels = {
        "in-stock": { label: "Disponible", cls: "bg-emerald-100 text-emerald-700" },
        limited: { label: "Pocas unidades", cls: "bg-amber-100 text-amber-700" },
        "out-of-stock": { label: "Agotado", cls: "bg-red-100 text-red-700" }
      };
      var formatter = new Intl.NumberFormat("es", { style: "currency", currency: "USD" });

      function renderCard(product) {
        var badge = availabilityLabels[product.availability] || availabilityLabels["in-stock"];
        var price = formatter.format(product.price);
        var compareAt = "";
        if (product.compareAtPrice && product.compareAtPrice > product.price) {
          compareAt = '<span class="text-sm text-text-light line-through">' + formatter.format(product.compareAtPrice) + '</span>';
        }
        var imgAlt = product.images.length > 0 ? product.name : "Imagen no disponible para " + product.name;
        var shortDesc = product.shortDescription ? '<p class="line-clamp-2 text-sm text-text-light">' + product.shortDescription + '</p>' : "";
        return '<a href="/producto/' + product.slug + '" class="group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-white shadow transition hover:shadow-lg scroll-mt-24 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="Ver ' + product.name + '">' +
          '<div class="relative aspect-[4/3] w-full overflow-hidden bg-light">' +
            '<img src="' + (product.images[0] || PLACEHOLDER) + '" alt="' + imgAlt + '" loading="lazy" width="400" height="300" decoding="async" class="h-full w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105" onerror="this.onerror=null;this.src=\'' + PLACEHOLDER + '\';this.srcset=\'\';this.alt=\'Imagen no disponible para ' + product.name + '\';" />' +
          '</div>' +
          '<div class="flex flex-1 flex-col gap-2 p-4">' +
            '<span class="inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ' + badge.cls + '">' + badge.label + '</span>' +
            '<h3 class="text-h6 font-bold leading-snug text-text-dark">' + product.name + '</h3>' +
            shortDesc +
            '<div class="mt-auto flex items-baseline gap-2 pt-2">' +
              '<span class="text-lg font-bold text-primary">' + price + '</span>' + compareAt +
            '</div>' +
          '</div>' +
        '</a>';
      }

      var currentFilters = { search: "", categories: [], priceMin: NaN, priceMax: NaN, availability: [] };
      var currentSort = "newest";
      var gridEl, resultsEl;

      function updateGrid() {
        if (!gridEl) return;
        var filtered = filterProducts(catalogData, currentFilters);
        var sorted = sortProducts(filtered, currentSort);
        if (sorted.length === 0) {
          gridEl.innerHTML =
            '<div class="col-span-full text-center py-16 md:py-24" role="status">' +
              '<svg class="mx-auto h-16 w-16 text-border" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>' +
              '<h2 class="mt-4 text-xl font-semibold text-text-dark">No hay resultados</h2>' +
              '<p class="mt-2 text-text-light max-w-md mx-auto">Intenta con otros filtros o términos de búsqueda.</p>' +
              '<div class="mt-6"><button class="btn btn-primary" id="empty-clear-btn">Limpiar filtros</button></div>' +
            '</div>';
          var clearBtn = document.getElementById("empty-clear-btn");
          if (clearBtn) clearBtn.addEventListener("click", clearAll);
        } else {
          gridEl.innerHTML = sorted.map(renderCard).join("");
          var imgs = gridEl.querySelectorAll("img");
          for (var i = 1; i < imgs.length; i++) imgs[i].loading = "lazy";
        }
        if (resultsEl) {
          resultsEl.textContent = sorted.length === 0
            ? "No se encontraron productos"
            : "Mostrando " + sorted.length + " de " + catalogData.length + " producto" + (catalogData.length !== 1 ? "s" : "");
        }
      }

      function visible(el) {
        return el && el.offsetParent !== null;
      }

      function collectFilters() {
        var cats = [];
        document.querySelectorAll('[data-filter="category"]:checked').forEach(function (cb) { cats.push(cb.value); });
        var avail = [];
        document.querySelectorAll('[data-filter="availability"]:checked').forEach(function (cb) { avail.push(cb.value); });
        // Price inputs live in two panels (desktop sidebar + mobile). Read from the
        // visible one so both panels drive the same filter state with no ID clash.
        var minEl = null, maxEl = null;
        document.querySelectorAll('[data-scope="price-min"]').forEach(function (el) { if (visible(el)) minEl = el; });
        document.querySelectorAll('[data-scope="price-max"]').forEach(function (el) { if (visible(el)) maxEl = el; });
        return {
          search: "", categories: cats,
          priceMin: minEl && minEl.value !== "" ? Number(minEl.value) : NaN,
          priceMax: maxEl && maxEl.value !== "" ? Number(maxEl.value) : NaN,
          availability: avail
        };
      }

      function clearAll() {
        document.querySelectorAll('[data-filter="category"]:checked, [data-filter="availability"]:checked').forEach(function (cb) { cb.checked = false; });
        document.querySelectorAll('[data-scope="price-min"], [data-scope="price-max"]').forEach(function (el) { el.value = ""; });
        currentFilters = { search: "", categories: [], priceMin: NaN, priceMax: NaN, availability: [] };
        currentSort = "newest";
        var sortEl = document.getElementById("sort-select");
        if (sortEl) sortEl.value = "newest";
        updateGrid();
      }

      function init() {
        gridEl = document.getElementById("product-grid");
        resultsEl = document.getElementById("catalog-results-count");
        document.querySelectorAll('[data-filter="category"]').forEach(function (cb) {
          cb.addEventListener("change", function () { currentFilters = collectFilters(); updateGrid(); });
        });
        document.querySelectorAll('[data-filter="availability"]').forEach(function (cb) {
          cb.addEventListener("change", function () { currentFilters = collectFilters(); updateGrid(); });
        });
        var priceTimer;
        document.querySelectorAll('[data-scope="price-min"], [data-scope="price-max"]').forEach(function (el) {
          el.addEventListener("input", function () {
            clearTimeout(priceTimer);
            priceTimer = setTimeout(function () { currentFilters = collectFilters(); updateGrid(); }, 400);
          });
        });
        var sortEl = document.getElementById("sort-select");
        if (sortEl) {
          sortEl.addEventListener("change", function () { currentSort = sortEl.value; updateGrid(); });
        }
        document.querySelectorAll('[data-scope="clear-filters"]').forEach(function (btn) {
          btn.addEventListener("click", clearAll);
        });
        currentFilters = collectFilters();
        updateGrid();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>

  <!-- Mobile filter toggle script -->
  <script is:inline>
    (function () {
      var toggle = document.getElementById("mobile-filter-toggle");
      var panel = document.getElementById("mobile-filters");
      if (!toggle || !panel) return;
      toggle.addEventListener("click", function () {
        var expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        panel.hidden = expanded;
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !panel.hidden) {
          toggle.setAttribute("aria-expanded", "false");
          panel.hidden = true;
          toggle.focus();
        }
      });
    })();
  </script>
</Base>
