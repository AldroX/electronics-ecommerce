---
/**
 * Productos catalog page — /productos/ (page 1) and /productos/2, /productos/3, etc.
 *
 * Uses Astro's spread rest param ([...page]) so paginate() works correctly.
 * Page 1 renders at /productos/, subsequent pages at /productos/N.
 *
 * Features:
 *  - Hero section (h1 + subheadline)
 *  - ProductFilters component (sidebar on desktop, collapsible on mobile)
 *  - ProductSort component
 *  - Paginated CatalogGrid using getStaticPaths + paginate() with 12 per page
 *  - Client-side filter/sort via vanilla JS (progressive enhancement)
 *  - Server-rendered first paint without JS dependency
 *
 * SEO:
 *  - Base.astro provides HTML shell with WebPage JSON-LD, canonical, OG/Twitter
 *  - Self-referencing canonical for each paginated URL
 *  - meta_title and description for catalog page
 */
import type { Product } from '../../data/types';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { fetchProducts, type FetchProductsResult } from '../../lib/api/fetchers';
import ProductFilters from '../../components/cards/ProductFilters.astro';
import CatalogGrid from '../../components/cards/CatalogGrid.astro';
import productsHeroBg from '../../assets/products/products-hero-new.webp';

export const prerender = false;

// Pre-load all assets in src/assets for dynamic lookup (same as ProductCard.astro)
const assetGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});

// Normalize glob keys for cross-platform compatibility (Windows uses backslashes)
function normalizeGlobKey(key: string): string {
  return key.replace(/\\/g, '/');
}

// Convert @/assets/ or ../assets/ to the glob key format
function toGlobKey(path: string): string {
  if (path.startsWith('@/assets/')) {
    return normalizeGlobKey('/src/' + path.slice(2)); // @/assets/ -> /src/assets/
  }
  if (path.startsWith('../assets/')) {
    return normalizeGlobKey('/src/assets/' + path.slice(10)); // ../assets/ -> /src/assets/
  }
  return '';
}

// Build a map from import path (e.g. "@/assets/products/panel-solar.webp") to resolved public URL
const normalizedAssetGlob: Record<string, { default: ImageMetadata } | undefined> = {};
for (const [key, value] of Object.entries(assetGlob)) {
  normalizedAssetGlob[normalizeGlobKey(key)] = value;
}

function resolveImageUrl(imagePath: string): string {
  // If it's an importable asset path, resolve to final public URL
  if (imagePath.startsWith('@/assets/') || imagePath.startsWith('../assets/')) {
    const globKey = toGlobKey(imagePath);
    const asset = normalizedAssetGlob[globKey]?.default;
    if (asset?.src) {
      return asset.src; // Final resolved URL with hash (e.g. /_astro/panel-solar.B45WK9N-_Z2m6MAA.avif)
    }
  }
  // Normalize legacy placeholder paths returned by remote data.
  return imagePath
    .replace('/images/placeholder-product.webp', '/images/placeholder-product.svg')
    .replace('/images/placeholder-category.webp', '/images/placeholder-category.svg');
}

// Transform products for client-side JSON: resolve @/assets/ paths to final URLs
function transformProductsForClient(products: Product[]): Product[] {
  return products.map((product) => ({
    ...product,
    images: product.images.map(resolveImageUrl),
  }));
}

interface CatalogPage {
  data: Product[];
  currentPage: number;
  lastPage: number;
  total: number;
  start: number;
  end: number;
  size: number;
  url: {
    current: string;
    prev: string | undefined;
    next: string | undefined;
    first: string | undefined;
    last: string | undefined;
  };
}

const currentPageParam = Math.max(1, parseInt(Astro.params.page ?? '1', 10) || 1);
const size = 12;

// Text search is server-driven (supports SSR reload, pagination and no-JS):
// ?search= is read on every request and applied by fetchProducts.
const searchParam = Astro.url.searchParams.get('search')?.trim() ?? '';

let result: FetchProductsResult;
try {
  result = await fetchProducts({
    limit: size,
    page: currentPageParam,
    search: searchParam || undefined,
  });
} catch (error) {
  console.error('Productos catalog: failed to fetch products from Supabase', error);
  result = { data: [], meta: { totalPages: 1, currentPage: 1, totalCount: 0 } };
}

const lastPage = Math.max(1, result.meta.totalPages);
const currentPage = Math.min(Math.max(1, currentPageParam), lastPage);
// Supabase rows come back loosely typed; the page object and grid consume the local Product type.
const data = result.data as Product[];
const start = (currentPage - 1) * size;
const end = start + data.length - 1;
const page: CatalogPage = {
  data,
  currentPage,
  lastPage,
  total: result.meta.totalCount,
  start,
  end,
  size,
  url: {
    current: currentPage === 1 ? '/productos/' : `/productos/${currentPage}`,
    prev: currentPage > 2 ? `/productos/${currentPage - 1}` : currentPage === 2 ? '/productos/' : undefined,
    next: currentPage < lastPage ? `/productos/${currentPage + 1}` : undefined,
    first: '/productos/',
    last: `/productos/${lastPage}`,
  },
};

const clientProducts = transformProductsForClient(page.data);

const metaTitle =
  page.currentPage > 1
    ? `Catálogo de Productos — Página ${page.currentPage}`
    : 'Catálogo de Productos | Energía Solar, Respaldo e Iluminación';
const description =
  'Explora nuestro catálogo de paneles solares, power stations, baterías LiFePO4, iluminación LED y accesorios. Filtra por búsqueda, categoría, precio y disponibilidad. Compra por WhatsApp.';
---

<Base meta_title={metaTitle} description={description} image={productsHeroBg.src}>
  <!-- Hero Section -->
  <section
    class="section relative overflow-hidden bg-cover bg-center bg-no-repeat md:min-h-[360px] lg:min-h-[420px]"
    aria-labelledby="catalog-title"
  >
    <img
      src={productsHeroBg.src}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    {/* Dark overlay for text readability */}
    <div class="absolute inset-0 bg-black/50" aria-hidden="true"></div>

    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 id="catalog-title" class="text-h1-sm md:text-h1 text-white">Catálogo de Productos</h1>
        <p class="mt-4 max-w-2xl text-base text-gray-300 md:text-lg">
          Encuentra la solución energética que necesitas. Filtra por búsqueda, categoría, precio y disponibilidad.
          Asesoría gratis por WhatsApp.
        </p>
      </div>
    </div>
  </section>

  <!-- Catalog Content -->
  <section class="section" aria-labelledby="catalog-results-title">
    <div class="container">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filters (Desktop) -->
        <aside class="lg:w-64 flex-shrink-0 hidden lg:block">
          <ProductFilters />
        </aside>

        <!-- Mobile Filter Toggle + Main Content -->
        <div class="flex-1 min-w-0">
          <!-- Mobile Filter Toggle -->
          <div class="lg:hidden mb-6">
            <button
              type="button"
              id="mobile-filter-toggle"
              aria-expanded="false"
              aria-controls="mobile-filters"
              class="btn btn-outline-primary w-full justify-center gap-2"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M3 3h18v18H3z"></path>
                <path d="M7 7h10"></path>
                <path d="M7 12h10"></path>
                <path d="M7 17h10"></path>
              </svg>
              Filtros
            </button>
            <div id="mobile-filters" class="mt-4" hidden role="region" aria-label="Filtros móviles">
              <ProductFilters />
            </div>
          </div>

          <!-- Catalog Grid (shared component) -->
          <CatalogGrid page={page} query={searchParam ? `search=${encodeURIComponent(searchParam)}` : undefined} />
        </div>
      </div>
    </div>
  </section>

  <!-- Embedded catalog data for client-side filtering (with resolved image URLs) -->
  <script type="application/json" id="catalog-data" is:inline set:html={JSON.stringify(clientProducts)} />

  <!-- Client-side filter/sort interactivity -->
  <script is:inline>
    (function () {
      var catalogData = JSON.parse(document.getElementById('catalog-data').textContent);

      function filterProducts(products, filters) {
        var result = products.slice();
        if (filters.search) {
          var q = filters.search.toLowerCase();
          result = result.filter(function (p) {
            return (
              p.name.toLowerCase().includes(q) ||
              p.description.toLowerCase().includes(q) ||
              p.shortDescription.toLowerCase().includes(q) ||
              p.tags.some(function (t) {
                return t.toLowerCase().includes(q);
              })
            );
          });
        }
        if (filters.categories && filters.categories.length > 0) {
          result = result.filter(function (p) {
            return filters.categories.includes(p.category);
          });
        }
        if (typeof filters.priceMin === 'number' && !isNaN(filters.priceMin)) {
          result = result.filter(function (p) {
            return p.price >= filters.priceMin;
          });
        }
        if (typeof filters.priceMax === 'number' && !isNaN(filters.priceMax)) {
          result = result.filter(function (p) {
            return p.price <= filters.priceMax;
          });
        }
        if (filters.availability && filters.availability.length > 0) {
          result = result.filter(function (p) {
            return filters.availability.includes(p.availability);
          });
        }
        return result;
      }

      function sortProducts(products, sortBy) {
        var sorted = products.slice();
        switch (sortBy) {
          case 'price-asc':
            sorted.sort(function (a, b) {
              return a.price - b.price;
            });
            break;
          case 'price-desc':
            sorted.sort(function (a, b) {
              return b.price - a.price;
            });
            break;
          case 'name-asc':
            sorted.sort(function (a, b) {
              return a.name.localeCompare(b.name, 'es');
            });
            break;
          default:
            break;
        }
        return sorted;
      }

      var PLACEHOLDER = '/images/placeholder-product.svg';
      var availabilityLabels = {
        'in-stock': { label: 'Disponible', cls: 'bg-emerald-100 text-emerald-700' },
        limited: { label: 'Pocas unidades', cls: 'bg-amber-100 text-amber-700' },
        'out-of-stock': { label: 'Agotado', cls: 'bg-red-100 text-red-700' },
      };
      var formatter = new Intl.NumberFormat('es', { style: 'currency', currency: 'USD' });

      function renderCard(product) {
        var badge = availabilityLabels[product.availability] || availabilityLabels['in-stock'];
        var price = formatter.format(product.price);
        var compareAt = '';
        if (product.compareAtPrice && product.compareAtPrice > product.price) {
          compareAt =
            '<span class="text-sm text-text-light line-through">' +
            formatter.format(product.compareAtPrice) +
            '</span>';
        }
        var imgAlt = product.images.length > 0 ? product.name : 'Imagen no disponible para ' + product.name;
        var shortDesc = product.shortDescription
          ? '<p class="line-clamp-2 text-sm text-text-light">' + product.shortDescription + '</p>'
          : '';

        return (
          '<a href="/producto/' +
          product.slug +
          '" class="admin-card-group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-white shadow transition hover:shadow-lg scroll-mt-24 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="Ver ' +
          product.name +
          '">' +
          '<div class="relative aspect-[4/3] w-full overflow-hidden bg-light">' +
          '<img src="' +
          (product.images[0] || PLACEHOLDER) +
          '" alt="' +
          imgAlt +
          '" loading="lazy" width="400" height="300" decoding="async" class="h-full w-full object-cover transition-transform duration-300 admin-card-image-hover" onerror="this.onerror=null;this.src=\'' +
          PLACEHOLDER +
          "';this.srcset='';this.alt='Imagen no disponible para " +
          product.name +
          '\';" />' +
          '</div>' +
          '<div class="flex flex-1 flex-col gap-2 p-4">' +
          '<span class="inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ' +
          badge.cls +
          '">' +
          badge.label +
          '</span>' +
          '<h3 class="text-h6 font-bold leading-snug text-text-dark">' +
          product.name +
          '</h3>' +
          shortDesc +
          '<div class="mt-auto flex flex-col items-start gap-1 pt-2 sm:flex-row sm:items-baseline sm:gap-2">' +
          '<span class="text-lg font-bold text-primary">' +
          price +
          '</span>' +
          compareAt +
          '</div>' +
          '</div>' +
          '</a>'
        );
      }

      var currentFilters = { search: '', categories: [], priceMin: NaN, priceMax: NaN, availability: [] };
      var currentSort = 'newest';
      var gridEl, resultsEl;

      function updateGrid() {
        if (!gridEl) return;
        var filtered = filterProducts(catalogData, currentFilters);
        var sorted = sortProducts(filtered, currentSort);

        if (sorted.length === 0) {
          gridEl.innerHTML =
            '<div class="col-span-full text-center py-16 md:py-24" role="status">' +
            '<svg class="mx-auto h-16 w-16 text-border" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>' +
            '<h2 class="mt-4 text-xl font-semibold text-text-dark">No hay resultados</h2>' +
            '<p class="mt-2 text-text-light max-w-md mx-auto">Intenta con otros filtros o términos de búsqueda.</p>' +
            '<div class="mt-6"><button class="btn btn-primary" id="empty-clear-btn">Limpiar filtros</button></div>' +
            '</div>';
          var clearBtn = document.getElementById('empty-clear-btn');
          if (clearBtn) clearBtn.addEventListener('click', clearAll);
        } else {
          gridEl.innerHTML = sorted.map(renderCard).join('');
          var imgs = gridEl.querySelectorAll('img');
          for (var i = 1; i < imgs.length; i++) imgs[i].loading = 'lazy';
        }

        if (resultsEl) {
          resultsEl.textContent =
            sorted.length === 0
              ? 'No se encontraron productos'
              : 'Mostrando ' +
                sorted.length +
                ' de ' +
                catalogData.length +
                ' producto' +
                (catalogData.length !== 1 ? 's' : '');
        }
      }

      function visible(el) {
        return el && el.offsetParent !== null;
      }

      function collectFilters() {
        var cats = [];
        document.querySelectorAll('[data-filter="category"]:checked').forEach(function (cb) {
          cats.push(cb.value);
        });
        var avail = [];
        document.querySelectorAll('[data-filter="availability"]:checked').forEach(function (cb) {
          avail.push(cb.value);
        });
        // Inputs live in two panels (desktop sidebar + mobile). Read from the
        // visible one so both panels drive the same filter state with no ID clash.
        var searchEl = null;
        var minEl = null,
          maxEl = null;
        document.querySelectorAll('[data-scope="search"]').forEach(function (el) {
          if (visible(el)) searchEl = el;
        });
        document.querySelectorAll('[data-scope="price-min"]').forEach(function (el) {
          if (visible(el)) minEl = el;
        });
        document.querySelectorAll('[data-scope="price-max"]').forEach(function (el) {
          if (visible(el)) maxEl = el;
        });
        return {
          search: searchEl ? searchEl.value.trim() : '',
          categories: cats,
          priceMin: minEl && minEl.value !== '' ? Number(minEl.value) : NaN,
          priceMax: maxEl && maxEl.value !== '' ? Number(maxEl.value) : NaN,
          availability: avail,
        };
      }

      function clearAll() {
        document
          .querySelectorAll('[data-filter="category"]:checked, [data-filter="availability"]:checked')
          .forEach(function (cb) {
            cb.checked = false;
          });
        document
          .querySelectorAll('[data-scope="search"], [data-scope="price-min"], [data-scope="price-max"]')
          .forEach(function (el) {
            el.value = '';
          });
        currentFilters = { search: '', categories: [], priceMin: NaN, priceMax: NaN, availability: [] };
        currentSort = 'newest';
        var sortEl = document.getElementById('sort-select');
        if (sortEl) sortEl.value = 'newest';
        updateGrid();
      }

      function init() {
        gridEl = document.getElementById('product-grid');
        resultsEl = document.getElementById('catalog-results-count');

        document.querySelectorAll('[data-filter="category"]').forEach(function (cb) {
          cb.addEventListener('change', function () {
            currentFilters = collectFilters();
            updateGrid();
          });
        });

        document.querySelectorAll('[data-filter="availability"]').forEach(function (cb) {
          cb.addEventListener('change', function () {
            currentFilters = collectFilters();
            updateGrid();
          });
        });

        var priceTimer;
        document.querySelectorAll('[data-scope="price-min"], [data-scope="price-max"]').forEach(function (el) {
          el.addEventListener('input', function () {
            clearTimeout(priceTimer);
            priceTimer = setTimeout(function () {
              currentFilters = collectFilters();
              updateGrid();
            }, 400);
          });
        });

        var searchTimer;
        document.querySelectorAll('[data-scope="search"]').forEach(function (el) {
          el.addEventListener('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
              currentFilters = collectFilters();
              updateGrid();
            }, 300);
          });
        });

        var sortEl = document.getElementById('sort-select');
        if (sortEl) {
          sortEl.addEventListener('change', function () {
            currentSort = sortEl.value;
            updateGrid();
          });
        }

        document.querySelectorAll('[data-scope="clear-filters"]').forEach(function (btn) {
          btn.addEventListener('click', clearAll);
        });

        currentFilters = collectFilters();
        updateGrid();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

  <!-- Mobile filter toggle script (progressive enhancement) -->
  <script is:inline>
    (function () {
      var toggle = document.getElementById('mobile-filter-toggle');
      var panel = document.getElementById('mobile-filters');
      if (!toggle || !panel) return;

      toggle.addEventListener('click', function () {
        var expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !panel.hidden) {
          toggle.setAttribute('aria-expanded', 'false');
          panel.hidden = true;
          toggle.focus();
        }
      });
    })();
  </script>

  <style is:global>
    .admin-card-group:hover .admin-card-image-hover {
      transform: scale(1.05);
    }

    @media (prefers-reduced-motion: reduce) {
      .admin-card-image-hover {
        transform: none;
      }
    }
  </style>
</Base>
