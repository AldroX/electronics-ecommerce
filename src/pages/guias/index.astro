---
/**
 * Guides landing page — /guias
 *
 * Lists all available guides as cards.
 *
 * Zero framework JS.
 */
import Base from '@/layouts/Base.astro';
import { getAllGuides } from '@/data/helpers/guides';
import GuiasCard from '@/components/cards/GuiasCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import config from '@/config/config.json';

const guides = getAllGuides();
const siteTitle = config.site.title;
const baseUrl = config.site.base_url;

// Breadcrumb items — relative urls for the visible nav, absolute for JSON-LD
const breadcrumbItems: Array<{ name: string; url?: string }> = [{ name: 'Inicio', url: '/' }, { name: 'Guías' }];

const breadcrumbJsonLdItems = breadcrumbItems.map((item) => (item.url ? { ...item, url: `${baseUrl}${item.url}` } : item));
---

<Base
  meta_title={`Guías | ${siteTitle}`}
  description="Guías y consejos prácticos sobre energía solar, baterías y respaldo eléctrico para hogares y negocios."
  canonical={`${baseUrl}/guias`}
  breadcrumbs={breadcrumbJsonLdItems}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />

      <h1 class="text-h2 mb-8">Guías y consejos</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => <GuiasCard guide={guide} />)}
      </div>
    </div>
  </section>
</Base>
