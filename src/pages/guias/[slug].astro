---
/**
 * Guide detail page — /guias/[slug]
 *
 * Shows guide article body, readTime badge, and related products grid.
 *
 * Zero framework JS.
 */
import type { GetStaticPaths } from "astro";
import type { Guide } from "@/data/types";
import { getAllGuides } from "@/data/helpers/guides";
import { getProductById } from "@/data/helpers/products";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import CTAWhatsApp from "@/components/ui/CTAWhatsApp.astro";

export const getStaticPaths: GetStaticPaths = () => {
  return getAllGuides().map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
};

const { guide } = Astro.props as { guide: Guide };
const siteTitle = config.site.title;
const baseUrl = config.site.base_url;

// Resolve related products
const relatedProducts = guide.products
  .map((id) => getProductById(id))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

// SEO
const pageTitle = guide.seo?.title || `${guide.title} | ${siteTitle}`;
const pageDescription = guide.seo?.description || guide.description;
const pageImage = guide.seo?.image || guide.image;
const canonicalUrl = guide.seo?.canonical || `${baseUrl}/guias/${guide.slug}`;

// Breadcrumb items
const breadcrumbItems: Array<{ name: string; url?: string }> = [
  { name: "Inicio", url: `${baseUrl}/` },
  { name: "Guías", url: `${baseUrl}/guias` },
  { name: guide.title },
];

// WhatsApp CTA message
const whatsappMessage = `Hola, leí la guía "${guide.title}" y tengo una consulta. ¿Podrían ayudarme?`;
---

<Base
  meta_title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbItems}
>
  <section class="section">
    <div class="container">
      {/* Breadcrumbs */}
      <nav aria-label="Miga de pan" class="mb-6 text-sm text-text-light">
        <ol class="flex flex-wrap items-center gap-1.5" role="list">
          {breadcrumbItems.map((item, index) => {
            const isLast = index === breadcrumbItems.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {index > 0 && (
                  <span class="text-text-light/50" aria-hidden="true">/</span>
                )}
                {isLast ? (
                  <span aria-current="page" class="font-medium text-text-dark">
                    {item.name}
                  </span>
                ) : (
                  <a
                    href={item.url}
                    class="text-primary underline-offset-2 hover:text-primary/80 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  >
                    {item.name}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </nav>

      {/* Guide header */}
      <div class="mb-8 max-w-3xl">
        <h1 class="text-h3 font-bold text-text-dark">{guide.title}</h1>
        <div class="mt-3 flex items-center gap-3">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">
            {guide.readTime} min de lectura
          </span>
        </div>
        {guide.description && (
          <p class="mt-4 text-lg text-text-light">{guide.description}</p>
        )}
      </div>

      {/* Article body */}
      <article class="prose prose-lg max-w-3xl text-text-dark prose-headings:font-bold prose-a:text-primary prose-strong:text-text-dark">
        <Fragment set:html={guide.content} />
      </article>

      {/* Related products */}
      {relatedProducts.length > 0 && (
        <div class="mt-12">
          <h2 class="text-h4 mb-6">Productos relacionados</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {relatedProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </div>
      )}

      {/* WhatsApp CTA */}
      <div class="mt-10">
        <CTAWhatsApp
          variant="inline"
          productName={guide.title}
          messageTemplate={whatsappMessage}
          class="w-fit"
        />
      </div>
    </div>
  </section>
</Base>
