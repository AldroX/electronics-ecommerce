---
/**
 * Guide detail page — /guias/[slug]
 *
 * Shows guide article body, readTime badge, and related products grid.
 *
 * Zero framework JS.
 */
import type { GetStaticPaths } from 'astro';
import type { Guide } from '@/data/types';
import { getAllGuides } from '@/data/helpers/guides';
import { getProductById } from '@/data/helpers/products';
import config from '@/config/config.json';
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/cards/ProductCard.astro';
import CTAWhatsApp from '@/components/ui/CTAWhatsApp.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';

export const getStaticPaths: GetStaticPaths = () => {
  return getAllGuides().map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
};

// Static: guides are build-time data, no per-request processing (§19 perf budget).
export const prerender = true;

const slug = Astro.params.slug;
const guideFromProps = (Astro.props as { guide?: Guide } | undefined)?.guide;
const guides = getAllGuides();
const guide = guideFromProps ?? guides.find((item) => item.slug === slug) ?? null;

if (!guide) {
  throw new Error('No se encontró la guía solicitada');
}

const siteTitle = config.site.title;
const baseUrl = config.site.base_url;

// Resolve related products
const relatedProducts = guide.products
  .map((id) => getProductById(id))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

// SEO
const pageTitle = guide.seo?.title || `${guide.title} | ${siteTitle}`;
const pageDescription = guide.seo?.description || guide.description;
const pageImage = guide.seo?.image || guide.image;
const canonicalUrl = guide.seo?.canonical || `${baseUrl}/guias/${guide.slug}`;

// Breadcrumb items — relative urls for the visible nav, absolute for JSON-LD
const breadcrumbItems: Array<{ name: string; url?: string }> = [
  { name: 'Inicio', url: '/' },
  { name: 'Guías', url: '/guias' },
  { name: guide.title },
];

const breadcrumbJsonLdItems = breadcrumbItems.map((item) => (item.url ? { ...item, url: `${baseUrl}${item.url}` } : item));

// WhatsApp CTA message
const whatsappMessage = `Hola, leí la guía "${guide.title}" y tengo una consulta. ¿Podrían ayudarme?`;
---

<Base
  meta_title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbJsonLdItems}
>
  <section class="section">
    <div class="container">
      {/* Breadcrumbs */}
      <Breadcrumbs items={breadcrumbItems} />

      {/* Guide header */}
      <div class="mb-8 max-w-3xl">
        <h1 class="text-h3 font-bold text-text-dark">{guide.title}</h1>
        <div class="mt-3 flex items-center gap-3">
          <span
            class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary"
          >
            {guide.readTime} min de lectura
          </span>
        </div>
        {guide.description && <p class="mt-4 text-lg text-text-light">{guide.description}</p>}
      </div>

      {/* Article body */}
      <article
        class="prose prose-lg max-w-3xl text-text-dark prose-headings:font-bold prose-a:text-primary prose-strong:text-text-dark"
      >
        <Fragment set:html={guide.content} />
      </article>

      {/* Related products */}
      {
        relatedProducts.length > 0 && (
          <div class="mt-12">
            <h2 class="text-h4 mb-6">Productos relacionados</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {relatedProducts.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
          </div>
        )
      }

      {/* WhatsApp CTA */}
      <div class="mt-10">
        <CTAWhatsApp variant="inline" productName={guide.title} messageTemplate={whatsappMessage} class="w-fit" />
      </div>
    </div>
  </section>
</Base>
