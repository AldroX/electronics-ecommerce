---
/**
 * Product detail page — /producto/[slug]
 *
 * Assembles WU-2 components (Gallery, Specs, PowerCalculator, RelatedProducts,
 * Breadcrumbs) plus inline WhatsApp CTA and Product JSON-LD structured data.
 *
 * Zero framework JS: all interactivity lives inside the child components.
 * UI copy in Spanish. Comments in English.
 */
import type { GetStaticPaths } from 'astro';
import type { Product, Category } from '@/data/types';
import { fetchProducts, fetchCategories } from '@/lib/api/fetchers';
import config from '@/config/config.json';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/product/Breadcrumbs.astro';
import ProductGallery from '@/components/product/ProductGallery.astro';
import ProductSpecs from '@/components/product/ProductSpecs.astro';
import PowerCalculator from '@/components/product/PowerCalculator.astro';
import RelatedProducts from '@/components/product/RelatedProducts.astro';
import CTAWhatsApp from '@/components/ui/CTAWhatsApp.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const result = await fetchProducts({ limit: 1000 });
  return result.data.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
};

// Static: build-time fetch from Supabase, no per-request DB hits (§19 perf budget).
export const prerender = true;

const allProductsResult = await fetchProducts({ limit: 1000 });
const allProducts = allProductsResult.data as Product[];
const slug = Astro.params.slug;
const productFromProps = (Astro.props as { product?: Product } | undefined)?.product;
const product = productFromProps ?? allProducts.find((item) => item.slug === slug);

if (!product) {
  throw new Error('No se encontró el producto solicitado');
}

// Resolve curated related products (ids or slugs, whatever the data layer
// returns) into display slugs, preserving DB order and skipping missing ones.
const relatedSlugs: string[] = product.relatedProducts
  .map((ref) => allProducts.find((p) => p.id === ref || p.slug === ref)?.slug)
  .filter((s): s is string => Boolean(s));

// Fetch all products and categories for related products and breadcrumbs
const [categoriesResult] = await Promise.all([fetchCategories()]);
const categories = categoriesResult.data as unknown as Category[];

// SEO
const siteTitle = config.site.title;
const baseUrl = config.site.base_url;
const pageTitle = product.seo?.title || `${product.name} | ${siteTitle}`;
const pageDescription = product.seo?.description || product.shortDescription || product.description || '';
const pageImage = product.seo?.image || product.images?.[0] || '/images/placeholder-product.svg';
const canonicalUrl = product.seo?.canonical || `${baseUrl}/producto/${product.slug}`;

// Breadcrumb items for JSON-LD in Base.astro <head>
const category = categories.find((c: Category) => c.slug === product.category);
const breadcrumbItems: Array<{ name: string; url?: string }> = [{ name: 'Inicio', url: `${baseUrl}/` }];
if (category) {
  breadcrumbItems.push({
    name: category.name,
    url: `${baseUrl}/categoria/${category.slug}`,
  });
}
breadcrumbItems.push({ name: product.name });

// Price formatting (matches ProductCard)
const formatter = new Intl.NumberFormat('es', {
  style: 'currency',
  currency: product.currency,
});
const showCompareAt = Boolean(product.compareAtPrice && product.compareAtPrice > product.price);
const price = formatter.format(product.price);
const compareAt = showCompareAt ? formatter.format(product.compareAtPrice!) : null;

// Availability badge (matches ProductCard)
const availabilityMap = {
  'in-stock': { label: 'Disponible', class: 'bg-emerald-100 text-emerald-700' },
  limited: { label: 'Pocas unidades', class: 'bg-amber-100 text-amber-700' },
  'out-of-stock': { label: 'Agotado', class: 'bg-red-100 text-red-700' },
} as const;
const stockKey = product.availability as keyof typeof availabilityMap;
const badge = availabilityMap[stockKey] ?? availabilityMap['in-stock'];

// WhatsApp: out-of-stock appends repo notice (matches ProductCard)
const isOutOfStock = product.availability === 'out-of-stock';
const whatsappMessage = isOutOfStock
  ? `${product.whatsappMessage} (Producto agotado, consultar reposición)`
  : undefined;

// Rating: rendered only when the DB provides it (rating column, post-migration).
const rating = product.rating;
const hasRating = typeof rating === 'number' && rating > 0;
const ratingText = hasRating ? String(Math.round(rating * 10) / 10) : '';
const ratingPercent = hasRating ? Math.min(100, Math.max(0, (rating / 5) * 100)) : 0;
const ratingLabel = hasRating
  ? `Valoración ${ratingText} de 5 estrellas${product.ratingCount ? ` (${product.ratingCount} valoraciones)` : ''}`
  : '';

// Descriptive blocks fed by the optional `details` column. Rendered only when
// at least one block is present — no empty blocks when details is absent.
const detailLabels = {
  whatIs: '¿Qué es?',
  purpose: '¿Para qué sirve?',
  forWhom: '¿Quién debería comprarlo?',
} as const;

const detailsBlocks: { title: string; text: string }[] = Object.entries(detailLabels).flatMap(([key, title]) => {
  const text = product.details?.[key as keyof typeof detailLabels]?.trim();
  return text ? [{ title, text }] : [];
});
---

<Base
  meta_title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  product={product}
  breadcrumbs={breadcrumbItems}
>
  <section class="container py-10">
    <Breadcrumbs product={product} categories={categories} />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
      {/* Gallery — left column */}
      <ProductGallery images={product.images} productName={product.name} />

      {/* Product info — right column */}
      <div class="flex flex-col gap-5">
        <h1 class="text-h3 font-bold leading-tight text-text-dark">
          {product.name}
        </h1>

        {/* Star rating — accessible shape (role="img" + aria-label), only when present */}
        {
          hasRating && (
            <div class="flex flex-wrap items-center gap-2">
              <span class="relative inline-flex" role="img" aria-label={ratingLabel}>
                {/* Base (empty) stars */}
                <span class="flex gap-0.5 text-border" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                    >
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  ))}
                </span>
                {/* Filled overlay clipped to the rating percentage */}
                <span
                  class="absolute inset-y-0 left-0 overflow-hidden"
                  style={`width:${ratingPercent}%`}
                  aria-hidden="true"
                >
                  <span class="flex gap-0.5 text-accent">
                    {Array.from({ length: 5 }).map(() => (
                      <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                      </svg>
                    ))}
                  </span>
                </span>
              </span>
              <span class="text-sm font-semibold text-text-dark">{ratingText}</span>
              {product.ratingCount != null && (
                <span class="text-sm text-text-light">({product.ratingCount} valoraciones)</span>
              )}
            </div>
          )
        }

        {product.shortDescription && <p class="text-base text-text-light">{product.shortDescription}</p>}

        {/* Price */}
        <div class="flex items-baseline gap-3">
          <span class="text-2xl font-bold text-primary">{price}</span>
          {showCompareAt && <span class="text-base text-text-light line-through">{compareAt}</span>}
        </div>

        {/* Availability badge */}
        <span
          class:list={['inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-xs font-semibold', badge.class]}
        >
          {badge.label}
        </span>

        {/* Inline WhatsApp CTA */}
        <CTAWhatsApp
          variant="inline"
          productName={product.name}
          productSlug={product.slug}
          messageTemplate={whatsappMessage}
          class="mt-1 w-fit"
        />
      </div>
    </div>

    {/* Description blocks — definition-style grid, only when details are present */}
    {
      detailsBlocks.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-6 text-h5 font-bold text-text-dark">Descripción</h2>
          <dl class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {detailsBlocks.map((block) => (
              <div class="rounded-lg border border-border bg-white p-5">
                <dt class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary">{block.title}</dt>
                <dd class="m-0 whitespace-pre-line leading-relaxed text-text-light">{block.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {/* Specs */}
    <div class="mt-12">
      <ProductSpecs specs={product.specs} />
    </div>

    {/* Power calculator — uses batteryWh when the product stores energy */}
    <div class="mt-12">
      <PowerCalculator batteryWh={product.batteryWh} />
    </div>

    {/* Related products */}
    <div class="mt-12">
      <RelatedProducts product={product} allProducts={allProducts} relatedSlugs={relatedSlugs} />
    </div>
  </section>
</Base>
