---
/**
 * Kit detail page — /kits/[slug]
 *
 * Hybrid of producto/[slug].astro + soluciones/[slug].astro patterns.
 * Shows kit details, price, included products, power calculator (if applicable),
 * WhatsApp CTA, and related kits.
 *
 * Zero framework JS.
 */
import type { GetStaticPaths } from "astro";
import type { Kit } from "@/data/types";
import { getAllKits } from "@/data/helpers/kits";
import { getProductById } from "@/data/helpers/products";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import KitCard from "@/components/cards/KitCard.astro";
import PowerCalculator from "@/components/product/PowerCalculator.astro";
import CTAWhatsApp from "@/components/ui/CTAWhatsApp.astro";

export const getStaticPaths: GetStaticPaths = () => {
  return getAllKits().map((kit) => ({
    params: { slug: kit.slug },
    props: { kit },
  }));
};

const { kit } = Astro.props as { kit: Kit };
const siteTitle = config.site.title;
const baseUrl = config.site.base_url;

// Resolve included products
const includedProducts = kit.products
  .map((id) => getProductById(id))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

// Calculate combined batteryWh for PowerCalculator
const combinedBatteryWh = includedProducts.reduce(
  (sum, product) => sum + (product.batteryWh ?? 0),
  0
);

// Price formatting (matches KitCard / ProductCard)
const formatter = new Intl.NumberFormat("es", {
  style: "currency",
  currency: "USD",
});
const price = formatter.format(kit.price);
const showCompareAt = Boolean(kit.compareAtPrice && kit.compareAtPrice > kit.price);
const compareAt = showCompareAt ? formatter.format(kit.compareAtPrice!) : null;
const savings = showCompareAt ? kit.compareAtPrice! - kit.price : 0;
const savingsFormatted = showCompareAt ? formatter.format(savings) : null;

// SEO
const pageTitle = kit.seo?.title || `${kit.name} | ${siteTitle}`;
const pageDescription = kit.seo?.description || kit.description;
const pageImage = kit.seo?.image || includedProducts[0]?.images[0];
const canonicalUrl = `${baseUrl}/kits/${kit.slug}`;

// Breadcrumb items
const breadcrumbItems: Array<{ name: string; url?: string }> = [
  { name: "Inicio", url: `${baseUrl}/` },
  { name: "Kits", url: `${baseUrl}/kits` },
  { name: kit.name },
];

// WhatsApp CTA message
const whatsappMessage = `Hola, estoy interesado en ${kit.name}. ¿Está disponible?`;

// Related kits: other kits sharing ≥1 product ID
const relatedKits = getAllKits()
  .filter((otherKit) => otherKit.id !== kit.id)
  .filter((otherKit) =>
    otherKit.products.some((productId) => kit.products.includes(productId))
  );
---

<Base
  meta_title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbItems}
>
  <section class="section">
    <div class="container">
      {/* Breadcrumbs */}
      <nav aria-label="Miga de pan" class="mb-6 text-sm text-text-light">
        <ol class="flex flex-wrap items-center gap-1.5" role="list">
          {breadcrumbItems.map((item, index) => {
            const isLast = index === breadcrumbItems.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {index > 0 && (
                  <span class="text-text-light/50" aria-hidden="true">/</span>
                )}
                {isLast ? (
                  <span aria-current="page" class="font-medium text-text-dark">
                    {item.name}
                  </span>
                ) : (
                  <a
                    href={item.url}
                    class="text-primary underline-offset-2 hover:text-primary/80 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  >
                    {item.name}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </nav>

      {/* Kit header */}
      <div class="mb-8">
        <h1 class="text-h3 font-bold leading-tight text-text-dark">
          {kit.name}
        </h1>
        {kit.description && (
          <p class="mt-3 text-lg text-text-light">{kit.description}</p>
        )}
      </div>

      {/* Price block + WhatsApp CTA inline */}
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between mb-8">
        <div class="flex flex-col gap-2">
          <div class="flex items-baseline gap-3">
            <span class="text-2xl font-bold text-primary">{price}</span>
            {showCompareAt && compareAt && (
              <span class="text-base text-text-light line-through">{compareAt}</span>
            )}
          </div>
          {showCompareAt && savingsFormatted && (
            <span class="inline-flex w-fit items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
              Ahorra {savingsFormatted}
            </span>
          )}
        </div>

        <CTAWhatsApp
          variant="inline"
          productName={kit.name}
          messageTemplate={whatsappMessage}
          class="w-fit md:w-auto"
        />
      </div>

      {/* Included products grid */}
      {includedProducts.length > 0 && (
        <div class="mb-12">
          <h2 class="text-h4 mb-6">Productos incluidos</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {includedProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </div>
      )}

      {/* Power calculator — shown when combined batteryWh > 0 */}
      <div class="mb-12">
        <PowerCalculator batteryWh={combinedBatteryWh} />
      </div>

      {/* Related kits */}
      {relatedKits.length > 0 && (
        <div class="mb-12">
          <h2 class="text-h4 mb-6">Kits relacionados</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {relatedKits.map((relatedKit) => (
              <KitCard kit={relatedKit} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>