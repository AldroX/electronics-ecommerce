---
import AdminLayout from '@/layouts/Admin.astro';

/**
 * Admin dashboard — redirects to products list
 */
---

<AdminLayout title="Dashboard" currentPath="/admin">
  <div class="flex items-center justify-center h-full">
    <div class="text-center">
      <h1 class="text-2xl font-bold text-text-dark mb-4">Panel de Administración</h1>
      <p class="text-text-light mb-6">Bienvenido al panel de control de EnergíaTotal</p>
      <a
        href="/admin/products"
        class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-colors min-h-[44px] touch-target"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
        </svg>
        Ir a Productos
      </a>
    </div>
  </div>
</AdminLayout>
