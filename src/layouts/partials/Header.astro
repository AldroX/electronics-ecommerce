---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import whatsapp from "@/config/whatsapp.json";

const { settings } = config;
const whatsappUrl = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.default_message)}`;

const isMenuItemActive = (url: string) => {
  const pathname = Astro.url.pathname;
  if (url === "/") return pathname === url;
  return pathname.startsWith(url);
};
---

<header
  class:list={[
    "header z-30 w-full bg-body transition-shadow duration-300",
    settings.sticky_header && "sticky top-0",
  ]}
>
  <nav class="container flex flex-wrap items-center justify-between py-4">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0">
      {config.site.logo ? (
        <img
          src={config.site.logo}
          alt={config.site.logo_text || config.site.title}
          width={config.site.logo_width}
          height={config.site.logo_height}
          class="h-10 w-auto"
        />
      ) : (
        <span class="text-xl font-bold text-text-dark">{config.site.logo_text || config.site.title}</span>
      )}
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden lg:flex items-center gap-6">
      {menu.main.map((item) => (
        <li>
          <a
            href={item.url}
            class:list={[
              "nav-link text-sm font-medium transition-colors hover:text-primary",
              isMenuItemActive(item.url) ? "text-primary" : "text-text-dark",
            ]}
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop actions -->
    <div class="hidden lg:flex items-center gap-4">
      <!-- WhatsApp CTA -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp btn-sm"
      >
        <svg class="inline-block w-4 h-4 mr-1 -mt-0.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        WhatsApp
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden flex items-center justify-center w-11 h-11 rounded-md border border-border text-text-dark"
      aria-label="Abrir menú"
    >
      <svg id="icon-menu-open" class="h-5 w-5 fill-current block" viewBox="0 0 20 20">
        <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0V15z" />
      </svg>
      <svg id="icon-menu-close" class="h-5 w-5 fill-current hidden" viewBox="0 0 20 20">
        <polygon points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2" transform="rotate(45 10 10)" />
      </svg>
    </button>
  </nav>

  <!-- Mobile sidebar overlay -->
  <div id="mobile-overlay" class="fixed inset-0 bg-black/50 z-40 hidden"></div>

  <!-- Mobile sidebar -->
  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 h-full w-80 bg-body overflow-y-auto z-50 p-6 transform -translate-x-full transition-transform duration-300"
  >
    <div class="flex justify-between items-center mb-8">
      <a href="/" class="flex items-center">
        {config.site.logo ? (
          <img
            src={config.site.logo}
            alt={config.site.logo_text || config.site.title}
            class="h-8 w-auto"
          />
        ) : (
          <span class="text-lg font-bold text-text-dark">{config.site.logo_text || config.site.title}</span>
        )}
      </a>
      <button id="mobile-menu-close" class="flex items-center justify-center w-11 h-11 rounded-md hover:bg-light" aria-label="Cerrar menú">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
          <polygon points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2" transform="rotate(45 10 10)" />
        </svg>
      </button>
    </div>

    <ul class="space-y-1">
      {menu.main.map((item) => (
        <li>
          <a
            href={item.url}
            class:list={[
              "block py-3 px-4 rounded-lg text-base font-medium transition-colors",
              isMenuItemActive(item.url)
                ? "bg-primary/10 text-primary"
                : "text-text-dark hover:bg-light",
            ]}
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>

    <!-- WhatsApp CTA in sidebar -->
    <div class="mt-6 pt-6 border-t border-border">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp w-full text-center"
      >
        <svg class="inline-block w-4 h-4 mr-1 -mt-0.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector("header");
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const closeBtn = document.getElementById("mobile-menu-close");
    const sidebar = document.getElementById("mobile-sidebar");
    const overlay = document.getElementById("mobile-overlay");
    const iconOpen = document.getElementById("icon-menu-open");
    const iconClose = document.getElementById("icon-menu-close");

    function openMenu() {
      sidebar?.classList.remove("-translate-x-full");
      overlay?.classList.remove("hidden");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      sidebar?.classList.add("-translate-x-full");
      overlay?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function updateShadow() {
      if (window.scrollY > 0) {
        header?.classList.add("shadow-sm");
      } else {
        header?.classList.remove("shadow-sm");
      }
    }

    window.addEventListener("scroll", updateShadow, { passive: true });
    toggleBtn?.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);

    // Close sidebar on link click (for SPA-like behavior)
    sidebar?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
