# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Application settings
NODE_ENV=development

# Site URL for magic link redirects and analytics
SITE_URL=http://localhost:4321

# Magic link and auth configuration
MAGIC_LINK_REDIRECT_URL=${SITE_URL}/auth/callback
DISABLE_EMAIL_CONFIRMATION_FOR_DEV=true

# Analytics HMAC secret for webhook verification
ANALYTICS_HMAC_SECRET=your_hmac_secret_key

# Feature flags (per page type)
FEATURES_products=api
FEATURES_categories=api
FEATURES_solutions=api
FEATURES_kits=api
FEATURES_offers=api
FEATURES_guides=api
FEATURES_faqs=api